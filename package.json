{
  "name": "thunderbird-time-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Thunderbird extension: projects, tasks and time entries in their own space tab.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run lint:ext",
    "lint": "eslint . && prettier --check src dev scripts tests eslint.config.js vitest.config.js playwright.config.js package.json tsconfig.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "lint:ext": "web-ext lint --source-dir src --ignore-files 'types/**'",
    "shots": "node scripts/shots.mjs",
    "tb": "node scripts/tb.mjs",
    "tb:spike": "node scripts/tb-spike.mjs",
    "build": "web-ext build --source-dir src --artifacts-dir dist --ignore-files 'types/**' --filename time-tracker-{version}.xpi --overwrite-dest",
    "icons": "node scripts/import-icons.mjs",
    "ref": "sh scripts/ref.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
