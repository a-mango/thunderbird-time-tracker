{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx web-ext lint *)",
      "Bash(npx web-ext build *)",
      "Bash(node scripts/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh label *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx playwright install *)"
    ],
    "deny": [
      "Read(~/.thunderbird/**)",
      "Edit(~/.thunderbird/**)",
      "Read(~/.var/app/org.mozilla.Thunderbird/**)",
      "Edit(~/.var/app/org.mozilla.Thunderbird/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.js|*.mjs|*.json|*.css|*.html) p=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\"; [ -x \"$p\" ] && \"$p\" --write --log-level warn \"$f\" ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
