{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.0.1",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "time-tracker@example.invalid",
      "strict_min_version": "157.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background/main.js"],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "ui/popup.html",
    "allowed_spaces": []
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_commandToggleTimer__"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  }
}
