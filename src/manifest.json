{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/time-tracker-16.svg",
    "32": "icons/time-tracker.svg",
    "64": "icons/time-tracker.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "time-tracker@a-mango.github.io",
      "strict_min_version": "157.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["alarms", "menus", "menus.overrideContext", "notifications"],
  "background": {
    "scripts": ["background/main.js"],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "ui/popup.html",
    "allowed_spaces": [],
    "default_icon": "icons/toolbar-dark.svg",
    "theme_icons": [
      {
        "dark": "icons/toolbar-dark.svg",
        "light": "icons/toolbar-light.svg",
        "size": 16
      },
      {
        "dark": "icons/toolbar-dark.svg",
        "light": "icons/toolbar-light.svg",
        "size": 32
      }
    ]
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_commandToggleTimer__"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  }
}
